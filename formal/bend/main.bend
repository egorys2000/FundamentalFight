# A deliberately small free-word core.
# Pos{n} and Neg{n} are the two orientations of a crag generator.

import Base

# The gameplay surface is currently modeled as a finite square tiling of
# the punctured plane. The tile lattice is an anchor representation only;
# its topology is the plane with the listed punctures removed.

type Tile:
  Tile{x: Nat, y: Nat}

type Puncture:
  Puncture{id: Nat, anchor: Tile}

type PuncturedPlane:
  Plane{width: Nat, height: Nat, punctures: List<Puncture>}

type FundamentalGroup:
  FreeGroup{generators: List<Puncture>}

type Point:
  Point{tile: Tile}

type Path:
  PathNil{}
  PathStep{point: Point, rest: Path}

type Letter:
  Pos{generator: Nat}
  Neg{generator: Nat}

type Word:
  Nil{}
  Cons{head: Letter, tail: Word}

type Loop:
  Closed{start: Point, path: Path, class: Word}

def fundamental_group(manifold) -> FundamentalGroup:
  match manifold:
    case Plane{width, height, punctures}:
      FreeGroup{generators: punctures}

def loop_class(loop) -> Word:
  match loop:
    case Closed{start, path, class}:
      class

def same_tile(a, b) -> Bool:
  match a b:
    case Tile{x, y} Tile{u, v}:
      Bool.and(Cmp.is_eq(Nat.cmp(x, u)), Cmp.is_eq(Nat.cmp(y, v)))

def path_ends_at(start, path) -> Bool:
  match start path:
    case Point{tile: a} PathNil{}:
      False{}
    case Point{tile: a} PathStep{point, rest}:
      match rest:
        case PathNil{}:
          match point:
            case Point{tile: b}:
              same_tile(a, b)
        case PathStep{}:
          path_ends_at(start, rest)

def is_closed(loop) -> Bool:
  match loop:
    case Closed{start, path, class}:
      path_ends_at(start, path)

def is_empty(word) -> Bool:
  match word:
    case Nil{}:
      True{}
    case Cons{}:
      False{}

def inverse(a, b) -> Bool:
  match a b:
    case Pos{x} Neg{y}:
      Cmp.is_eq(Nat.cmp(x, y))
    case Neg{x} Pos{y}:
      Cmp.is_eq(Nat.cmp(x, y))
    case _ _:
      False{}

def push(letter, word) -> Word:
  match word:
    case Nil{}:
      Cons{head: letter, tail: Nil{}}
    case Cons{head, tail}:
      match inverse(letter, head):
        case True{}:
          tail
        case False{}:
          Cons{head: letter, tail: word}

def reduce(word) -> Word:
  match word:
    case Nil{}:
      Nil{}
    case Cons{head, tail}:
      push(head, reduce(tail))

# The fundamental group of the plane with n punctures is the free group
# generated by those punctures. `class` is the chosen generator word for a
# geometric closed path. The geometry-to-word construction is kept as an
# explicit boundary until the tile routing algorithm is formalized.
def is_trivial(word) -> Bool:
  is_empty(reduce(word))

def is_trivial_loop(loop) -> Bool:
  match loop:
    case Closed{start, path, class}:
      Bool.and(is_closed(loop), is_trivial(class))
